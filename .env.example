# EduSphere v2 — frontend environment
# Copy to .env.local and fill in. Everything here ships to the browser, so it
# must contain only public keys. Secrets live in Edge Function config (below).

# ── Supabase (required) ──────────────────────────────────────────────────────
# https://supabase.com/dashboard/project/YOUR_REF/settings/api
# This is the PRIMARY (reads + writes). Today, with no self-hosted server
# yet, point this at your Supabase Cloud project exactly as before — that is
# a complete, supported, single-tier configuration on its own.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── Supabase failover (optional) ─────────────────────────────────────────────
# Leave BOTH unset to run single-tier against the project above — no health
# checks, no extra network calls, behavior identical to not having this
# section at all. This is the state the app ships in today.
#
# Set BOTH to enable automatic read-only failover: once VITE_SUPABASE_URL
# above is repointed at a self-hosted primary, put the CURRENT Supabase
# Cloud project's URL/anon key here instead, so the app keeps serving reads
# (exams, schedules, courses) if the self-hosted primary goes down. Writes
# are rejected client-side while failed over — see docs/ARCHITECTURE-HA.md
# for the full topology, replication setup, and failover/failback runbook,
# including the one-time JWT-signing-key step required for an
# already-signed-in student's session to be recognized by this project too.
VITE_SUPABASE_FALLBACK_URL=
VITE_SUPABASE_FALLBACK_ANON_KEY=

# ── Sentry (optional — absent means Sentry is fully inert) ───────────────────
# The DSN is a public value and is safe to expose.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# 0–1. Defaults: traces 1 in dev / 0.2 in prod, replay 1 in dev / 0.1 in prod.
# Errors are always replayed regardless of the replay rate.
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_REPLAY_SAMPLE_RATE=

# Tags releases in Sentry so a stack trace maps to a known build.
VITE_APP_VERSION=

# PostHog product analytics (optional; disabled without both values)
# Create a project in your preferred data region, then set its public project
# token (phc_...) and regional ingestion host. Do not use a personal phx_ key.
# Analytics starts by default once configured; automatic capture and session
# replay remain disabled. Recommended EU host: https://eu.i.posthog.com
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ═════════════════════════════════════════════════════════════════════════════
# EDGE FUNCTION SECRETS — never put these in .env.local, they are server-side.
#
#   supabase secrets set NAME=value
#
#   UNIVERSITY_API_BASE_URL   Base URL of the university API, no trailing slash.
#                             Local mock: http://host.docker.internal:8787
#   UNIVERSITY_API_KEY        Bearer token. Mock default: dev-university-key
#   RESEND_API_KEY            Resend key used to email the sign-in code.
#   RESEND_FROM_EMAIL        Verified sender address.
#   APP_ORIGIN                Exact site origin, for CORS. Avoid "*" in prod.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
#
# See docs/UNIVERSITY-API.md for the contract these endpoints must satisfy.
# ═════════════════════════════════════════════════════════════════════════════
